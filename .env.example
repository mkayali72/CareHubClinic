# Application settings used by the app container.
APP_NAME=OB/GYN Clinic
APP_ENV=development
HOST=0.0.0.0
PORT=8000
SESSION_SECRET=replace-this-with-a-long-random-value
SESSION_MAX_AGE_SECONDS=1209600
SESSION_INACTIVITY_SECONDS=1800
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
LICENSE_CHECK_INTERVAL_SECONDS=300
LAB_UPLOAD_DIR=var/lab_results

# Database URL used by a process running inside Docker Compose.
# The service hostname is "db"; use "localhost" only for a process running
# directly on the host.
DATABASE_URL=postgresql+psycopg://clinic:clinic@db:5432/obgyn

# PostgreSQL settings used by docker-compose.yml.
POSTGRES_DB=obgyn
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic