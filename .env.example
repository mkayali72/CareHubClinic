# Application settings
APP_NAME=OB/GYN Clinic
APP_ENV=development
PORT=8000
SESSION_SECRET=replace-this-with-a-long-random-value
SESSION_MAX_AGE_SECONDS=1209600
SESSION_INACTIVITY_SECONDS=1800
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
LICENSE_CHECK_INTERVAL_SECONDS=300

# Local Docker Desktop database URL.
# The Docker Compose service uses the hostname "db"; use "localhost" outside Docker.
DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:5432/obgyn

# PostgreSQL settings used by docker-compose.yml
POSTGRES_DB=obgyn
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic